{
  "name": "opencrbasic",
  "displayName": "CRBasic (opencrbasic)",
  "description": "CRBasic language support for CR6 programs, backed by the opencrbasic language server.",
  "publisher": "OttodeVisserUU",
  "version": "1.5.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/UtrechtUniversity/open-crbasic-vsix.git"
  },
  "bugs": {
    "url": "https://github.com/UtrechtUniversity/open-crbasic-vsix/issues"
  },
  "homepage": "https://github.com/UtrechtUniversity/open-crbasic-vsix#readme",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:crbasic"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Runs a Python language server from the configured interpreter. Trust this folder to enable CRBasic language support."
    }
  },
  "contributes": {
    "configurationDefaults": {
      "[crbasic]": {
        "editor.inlayHints.maximumLength": 0,
        "editor.formatOnType": true
      }
    },
    "languages": [
      {
        "id": "crbasic",
        "aliases": [
          "CRBasic"
        ],
        "extensions": [
          ".CR6",
          ".cr6",
          ".crb",
          ".CRB",
          ".CR1X",
          ".cr1x",
          ".CR300",
          ".cr300",
          ".CR350",
          ".cr350",
          ".DLD",
          ".dld"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "media/icons/light/crbasic-file.svg",
          "dark": "media/icons/dark/crbasic-file.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "crbasic",
        "scopeName": "source.crbasic",
        "path": "./syntaxes/crbasic.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "opencrbasic.restartServer",
        "title": "opencrbasic: Restart Server"
      },
      {
        "command": "opencrbasic.openCompilerOutput",
        "title": "opencrbasic: Show Compiler Output"
      },
      {
        "command": "opencrbasic.openTableFields",
        "title": "opencrbasic: Show Table Fields"
      },
      {
        "command": "opencrbasic.newProgram",
        "title": "CRBasic: New Program...",
        "shortTitle": "CRBasic Program"
      },
      {
        "command": "opencrbasic.showReferences",
        "title": "opencrbasic: Show References"
      },
      {
        "command": "opencrbasic.instructions.search",
        "title": "Search Instructions",
        "icon": "$(search)"
      },
      {
        "command": "opencrbasic.instructions.filter",
        "title": "Filter Instructions",
        "icon": "$(filter)"
      },
      {
        "command": "opencrbasic.instructions.clearFilter",
        "title": "Clear Filter",
        "icon": "$(clear-all)"
      },
      {
        "command": "opencrbasic.instructions.refresh",
        "title": "Refresh Instructions",
        "icon": "$(refresh)"
      },
      {
        "command": "opencrbasic.instructions.insert",
        "title": "Insert Instruction",
        "icon": "$(add)"
      },
      {
        "command": "opencrbasic.instructions.help",
        "title": "Show Instruction Help",
        "icon": "$(question)"
      },
      {
        "command": "opencrbasic.dataTables.refresh",
        "title": "Refresh Data Tables",
        "icon": "$(refresh)"
      },
      {
        "command": "openloggernet.openPanel",
        "title": "Logger: Open Panel"
      },
      {
        "command": "openloggernet.selectLogger",
        "title": "Logger: Select Serial Port...",
        "icon": {
          "light": "media/icons/light/port.svg",
          "dark": "media/icons/dark/port.svg"
        }
      },
      {
        "command": "openloggernet.showInfo",
        "title": "Logger: Show Station Info"
      },
      {
        "command": "openloggernet.sendProgram",
        "title": "Logger: Send and Run",
        "icon": {
          "light": "media/icons/light/send-run.svg",
          "dark": "media/icons/dark/send-run.svg"
        }
      },
      {
        "command": "openloggernet.collect",
        "title": "Logger: Collect Table..."
      },
      {
        "command": "openloggernet.stopProgram",
        "title": "Logger: Stop Program (keep data)"
      },
      {
        "command": "openloggernet.resumeProgram",
        "title": "Logger: Resume Program"
      },
      {
        "command": "openloggernet.setClock",
        "title": "Logger: Sync Clock to UTC",
        "icon": {
          "light": "media/icons/light/sync-clock.svg",
          "dark": "media/icons/dark/sync-clock.svg"
        }
      },
      {
        "command": "openloggernet.build",
        "title": "Logger: Build",
        "icon": {
          "light": "media/icons/light/build.svg",
          "dark": "media/icons/dark/build.svg"
        }
      },
      {
        "command": "openloggernet.buildSendRun",
        "title": "Logger: Build, Send and Run",
        "icon": {
          "light": "media/icons/light/build-send-run.svg",
          "dark": "media/icons/dark/build-send-run.svg"
        }
      },
      {
        "command": "openloggernet.buildSendRunMonitor",
        "title": "Logger: Build, Send, Run and Monitor",
        "icon": {
          "light": "media/icons/light/build-send-run-monitor.svg",
          "dark": "media/icons/dark/build-send-run-monitor.svg"
        }
      },
      {
        "command": "openloggernet.downloadTables",
        "title": "Logger: Download Data Tables...",
        "icon": {
          "light": "media/icons/light/download-tables.svg",
          "dark": "media/icons/dark/download-tables.svg"
        }
      },
      {
        "command": "openloggernet.downloadAllTables",
        "title": "Logger: Download All Data Tables",
        "icon": {
          "light": "media/icons/light/download-tables.svg",
          "dark": "media/icons/dark/download-tables.svg"
        }
      },
      {
        "command": "openloggernet.downloadTable",
        "title": "Logger: Download Table",
        "icon": {
          "light": "media/icons/light/download.svg",
          "dark": "media/icons/dark/download.svg"
        }
      },
      {
        "command": "openloggernet.updateOs",
        "title": "Logger: Update Operating System...",
        "icon": {
          "light": "media/icons/light/update-os.svg",
          "dark": "media/icons/dark/update-os.svg"
        }
      },
      {
        "command": "openloggernet.scan.station",
        "title": "Logger: Scan Datalogger",
        "icon": {
          "light": "media/icons/light/refresh.svg",
          "dark": "media/icons/dark/refresh.svg"
        }
      },
      {
        "command": "openloggernet.scan.files",
        "title": "Logger: Scan Files",
        "icon": {
          "light": "media/icons/light/refresh.svg",
          "dark": "media/icons/dark/refresh.svg"
        }
      },
      {
        "command": "openloggernet.scan.tables",
        "title": "Logger: Scan Data Tables",
        "icon": {
          "light": "media/icons/light/refresh.svg",
          "dark": "media/icons/dark/refresh.svg"
        }
      },
      {
        "command": "openloggernet.scan.settings",
        "title": "Logger: Scan Settings",
        "icon": {
          "light": "media/icons/light/refresh.svg",
          "dark": "media/icons/dark/refresh.svg"
        }
      },
      {
        "command": "openloggernet.connect",
        "title": "Logger: Connect Live Values",
        "icon": {
          "light": "media/icons/light/connect.svg",
          "dark": "media/icons/dark/connect.svg"
        }
      },
      {
        "command": "openloggernet.disconnect",
        "title": "Logger: Disconnect Live Values",
        "icon": {
          "light": "media/icons/light/disconnect.svg",
          "dark": "media/icons/dark/disconnect.svg"
        }
      },
      {
        "command": "openloggernet.uploadFiles",
        "title": "Logger: Upload Files...",
        "icon": {
          "light": "media/icons/light/upload.svg",
          "dark": "media/icons/dark/upload.svg"
        }
      },
      {
        "command": "openloggernet.downloadFiles",
        "title": "Logger: Download File",
        "icon": {
          "light": "media/icons/light/download.svg",
          "dark": "media/icons/dark/download.svg"
        }
      },
      {
        "command": "openloggernet.deleteFiles",
        "title": "Logger: Delete File",
        "icon": {
          "light": "media/icons/light/delete.svg",
          "dark": "media/icons/dark/delete.svg"
        }
      },
      {
        "command": "openloggernet.runFile",
        "title": "Logger: Compile and Run File",
        "icon": {
          "light": "media/icons/light/run.svg",
          "dark": "media/icons/dark/run.svg"
        }
      },
      {
        "command": "openloggernet.setVariable",
        "title": "Logger: Set Value...",
        "icon": {
          "light": "media/icons/light/edit.svg",
          "dark": "media/icons/dark/edit.svg"
        }
      },
      {
        "command": "openloggernet.editSetting",
        "title": "Logger: Change Setting...",
        "icon": {
          "light": "media/icons/light/edit.svg",
          "dark": "media/icons/dark/edit.svg"
        }
      }
    ],
    "configuration": {
      "title": "opencrbasic",
      "properties": {
        "opencrbasic.pythonPath": {
          "type": "string",
          "default": "python3",
          "description": "Python interpreter that runs the opencrbasic language server. It needs the opencrbasic package and pygls (the lsp extra). When not set, the interpreter of `uv tool install \"opencrbasic[lsp]\"` is used if it exists, else python3."
        },
        "opencrbasic.serverArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "-m",
            "opencrbasic.lsp"
          ],
          "description": "Arguments passed to pythonPath to start the language server."
        },
        "opencrbasic.serverEnv": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "Extra environment variables for the server process, for example PYTHONPATH pointing at a development checkout. These override inherited variables."
        },
        "opencrbasic.entries": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/*.{CR6,CR1X,CR300,CR350}"
          ],
          "description": "Workspace-relative glob patterns of entry programs. Each entry is analyzed with its includes."
        },
        "opencrbasic.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Workspace-relative glob patterns removed from the entries."
        },
        "opencrbasic.logger": {
          "type": "string",
          "enum": [
            "auto",
            "cr6",
            "cr1000x",
            "cr300",
            "cr350"
          ],
          "default": "auto",
          "enumDescriptions": [
            "Each program's logger from its extension: .CR6, .CR1X, .CR300, .CR350.",
            "CR6",
            "CR1000X",
            "CR300",
            "CR350"
          ],
          "description": "Logger profile used to analyze and build entry programs. `auto` takes it from each program's extension, as `crbc` does; a fixed logger applies to every program and only its own extension (and .CR6) makes a file an entry."
        },
        "opencrbasic.encoding": {
          "type": "string",
          "default": "utf-8",
          "description": "Text encoding used to read unsaved document content and files."
        },
        "opencrbasic.debounceMs": {
          "type": "integer",
          "default": 300,
          "minimum": 0,
          "description": "Delay in milliseconds after the last edit before analysis starts."
        },
        "opencrbasic.analysisTimeoutMs": {
          "type": "integer",
          "default": 10000,
          "minimum": 1,
          "description": "Maximum time in milliseconds for one analysis before it is abandoned."
        },
        "opencrbasic.maxFileBytes": {
          "type": "integer",
          "default": 2097152,
          "minimum": 1,
          "description": "Files larger than this many bytes are not analyzed. The entries that read such a file report a warning instead of diagnostics."
        },
        "opencrbasic.maxQueuedJobs": {
          "type": "integer",
          "default": 64,
          "minimum": 1,
          "description": "Maximum number of entry programs analyzed at once. The others wait and run as slots free; none is dropped."
        },
        "opencrbasic.maxCacheMb": {
          "type": "integer",
          "default": 256,
          "minimum": 1,
          "description": "Memory in megabytes for parsed programs kept for hover, completion and navigation. The least recently used program is dropped when it is exceeded."
        },
        "opencrbasic.checks": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string",
            "enum": [
              "error",
              "warning",
              "info",
              "off"
            ]
          },
          "markdownDescription": "Severity per opencrbasic check code, for example `{\"OCB005\": \"off\"}`. Overrides `opencrbasic.toml` (its `[checks]`, `[profile.*]` and `[entry.*]` tables). Checks run only on programs the reference compiler accepts."
        },
        "opencrbasic.coverageNotices": {
          "type": "boolean",
          "default": false,
          "description": "Show coverage notices as hints: at the first use of a CR6 instruction, the reference compiler rules opencrbasic does not model. Information only, never a compiler verdict."
        },
        "opencrbasic.helpDirectory": {
          "type": "string",
          "default": "",
          "description": "Directory holding the extracted CRBasic help (Instructions/*.htm and parameters/*.htm). A relative path is resolved against the first workspace folder. Empty: hover and signature help show no help text."
        },
        "opencrbasic.inlayHints.parameterNames": {
          "type": "boolean",
          "default": true,
          "description": "Show the parameter name before each argument of an instruction or function call (for example Dest: before the first VoltSe argument). It needs helpDirectory: with no help text there are no hints."
        },
        "opencrbasic.unusedHints": {
          "type": "boolean",
          "default": true,
          "description": "Fade variables, constants, tables, subroutines and functions that nothing in the program uses (only while the program has no errors)."
        },
        "opencrbasic.codeLens.references": {
          "type": "boolean",
          "default": true,
          "description": "Show the number of references above each declaration; click it to list them."
        },
        "opencrbasic.caseCorrection": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Respell a name as you type to its declaration's spelling, or to the conventional spelling of a keyword, data type or instruction (`beginprog` becomes `BeginProg`). Needs `editor.formatOnType`, which this extension turns on for CRBasic."
        },
        "opencrbasic.compiler": {
          "type": "string",
          "enum": [
            "python",
            "rust"
          ],
          "default": "python",
          "enumDescriptions": [
            "The Python compiler inside the language server; compiles unsaved changes too.",
            "The Rust `crbc` of open-crbasic-rs; saves the program first."
          ],
          "description": "Compiler for Logger: Build and Show Compiler Output. Diagnostics always come from the language server."
        },
        "opencrbasic.crbcPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "The Rust `crbc` for `opencrbasic.compiler: rust`. Empty: `crbc` in Cargo's bin directory (`cargo install opencrbasic`), else `crbc` on PATH, which may be the Python one."
        },
        "opencrbasic.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace of client-server messages in the opencrbasic output channel."
        },
        "openloggernet.command": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Command that runs open-loggernet's `oln`, e.g. `[\"uv\", \"run\", \"--project\", \"/path/to/open-loggernet\", \"oln\"]` for a checkout. Empty: the `oln` of `uv tool install openloggernet` if it exists, else `oln` on PATH; the extension offers to install or upgrade open-loggernet with uv."
        },
        "openloggernet.port": {
          "type": "string",
          "default": "",
          "description": "Serial port of the logger to use, e.g. COM5 or /dev/ttyACM0. Empty: the logger chosen with Logger: Select Logger, or the only one attached."
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "opencrbasic.openCompilerOutput",
          "when": "editorLangId == crbasic"
        },
        {
          "command": "opencrbasic.openTableFields",
          "when": "editorLangId == crbasic"
        },
        {
          "command": "openloggernet.build",
          "when": "editorLangId == crbasic"
        },
        {
          "command": "openloggernet.buildSendRun",
          "when": "editorLangId == crbasic"
        },
        {
          "command": "openloggernet.buildSendRunMonitor",
          "when": "editorLangId == crbasic"
        },
        {
          "command": "openloggernet.sendProgram",
          "when": "editorLangId == crbasic"
        },
        {
          "command": "openloggernet.downloadTable",
          "when": "false"
        },
        {
          "command": "openloggernet.downloadFiles",
          "when": "false"
        },
        {
          "command": "openloggernet.deleteFiles",
          "when": "false"
        },
        {
          "command": "openloggernet.runFile",
          "when": "false"
        },
        {
          "command": "openloggernet.setVariable",
          "when": "false"
        },
        {
          "command": "openloggernet.editSetting",
          "when": "false"
        },
        {
          "command": "openloggernet.downloadAllTables",
          "when": "false"
        },
        {
          "command": "openloggernet.disconnect",
          "when": "openloggernet.connected"
        },
        {
          "command": "opencrbasic.showReferences",
          "when": "false"
        },
        {
          "command": "opencrbasic.instructions.insert",
          "when": "false"
        },
        {
          "command": "opencrbasic.instructions.help",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "openloggernet.build",
          "when": "editorLangId == crbasic",
          "group": "navigation@1"
        },
        {
          "command": "openloggernet.buildSendRun",
          "when": "editorLangId == crbasic",
          "group": "navigation@2"
        },
        {
          "command": "openloggernet.buildSendRunMonitor",
          "when": "editorLangId == crbasic",
          "group": "navigation@3"
        },
        {
          "command": "openloggernet.sendProgram",
          "when": "editorLangId == crbasic",
          "group": "navigation@4"
        }
      ],
      "explorer/context": [
        {
          "command": "openloggernet.buildSendRun",
          "when": "resourceLangId == crbasic",
          "group": "openloggernet@1"
        },
        {
          "command": "openloggernet.sendProgram",
          "when": "resourceLangId == crbasic",
          "group": "openloggernet@2"
        }
      ],
      "view/title": [
        {
          "command": "openloggernet.scan.station",
          "when": "view == openloggernet.station && openloggernet.filled.station",
          "group": "navigation"
        },
        {
          "command": "openloggernet.selectLogger",
          "when": "view == openloggernet.station",
          "group": "navigation"
        },
        {
          "command": "openloggernet.setClock",
          "when": "view == openloggernet.station && openloggernet.filled.station",
          "group": "navigation"
        },
        {
          "command": "openloggernet.uploadFiles",
          "when": "view == openloggernet.files",
          "group": "navigation"
        },
        {
          "command": "openloggernet.scan.files",
          "when": "view == openloggernet.files && openloggernet.filled.files",
          "group": "navigation"
        },
        {
          "command": "openloggernet.connect",
          "when": "view == openloggernet.public && !openloggernet.connected",
          "group": "navigation"
        },
        {
          "command": "openloggernet.disconnect",
          "when": "view == openloggernet.public && openloggernet.connected",
          "group": "navigation"
        },
        {
          "command": "openloggernet.downloadAllTables",
          "when": "view == openloggernet.tables && openloggernet.filled.tables",
          "group": "navigation"
        },
        {
          "command": "openloggernet.scan.tables",
          "when": "view == openloggernet.tables && openloggernet.filled.tables",
          "group": "navigation"
        },
        {
          "command": "openloggernet.scan.settings",
          "when": "view == openloggernet.settings && openloggernet.filled.settings",
          "group": "navigation"
        },
        {
          "command": "opencrbasic.instructions.search",
          "when": "view == opencrbasic.instructions",
          "group": "navigation@1"
        },
        {
          "command": "opencrbasic.instructions.filter",
          "when": "view == opencrbasic.instructions",
          "group": "navigation@2"
        },
        {
          "command": "opencrbasic.instructions.clearFilter",
          "when": "view == opencrbasic.instructions",
          "group": "navigation@3"
        },
        {
          "command": "opencrbasic.instructions.refresh",
          "when": "view == opencrbasic.instructions",
          "group": "navigation@4"
        },
        {
          "command": "opencrbasic.dataTables.refresh",
          "when": "view == opencrbasic.dataTables",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "openloggernet.updateOs",
          "when": "view == openloggernet.station && viewItem =~ /^osOutdated$/",
          "group": "inline"
        },
        {
          "command": "openloggernet.setClock",
          "when": "view == openloggernet.station && viewItem =~ /^clockOff$/",
          "group": "inline"
        },
        {
          "command": "openloggernet.selectLogger",
          "when": "view == openloggernet.station && viewItem =~ /^port$/",
          "group": "inline"
        },
        {
          "command": "openloggernet.runFile",
          "when": "view == openloggernet.files && viewItem =~ /^programFile$/",
          "group": "inline@1"
        },
        {
          "command": "openloggernet.downloadFiles",
          "when": "view == openloggernet.files && viewItem =~ /^(programF|f)ile$/",
          "group": "inline@2"
        },
        {
          "command": "openloggernet.deleteFiles",
          "when": "view == openloggernet.files && viewItem =~ /^(programF|f)ile$/",
          "group": "inline@3"
        },
        {
          "command": "openloggernet.runFile",
          "when": "view == openloggernet.files && viewItem =~ /^programFile$/",
          "group": "1_actions@1"
        },
        {
          "command": "openloggernet.downloadFiles",
          "when": "view == openloggernet.files && viewItem =~ /^(programF|f)ile$/",
          "group": "1_actions@2"
        },
        {
          "command": "openloggernet.deleteFiles",
          "when": "view == openloggernet.files && viewItem =~ /^(programF|f)ile$/",
          "group": "1_actions@3"
        },
        {
          "command": "openloggernet.downloadTable",
          "when": "view == openloggernet.tables && viewItem =~ /^table$/",
          "group": "inline"
        },
        {
          "command": "openloggernet.setVariable",
          "when": "view == openloggernet.public && viewItem =~ /^variable$/",
          "group": "inline"
        },
        {
          "command": "openloggernet.editSetting",
          "when": "view == openloggernet.settings && viewItem =~ /^setting$/",
          "group": "inline"
        },
        {
          "command": "opencrbasic.instructions.insert",
          "when": "view == opencrbasic.instructions && viewItem == instruction",
          "group": "inline@1"
        },
        {
          "command": "opencrbasic.instructions.help",
          "when": "view == opencrbasic.instructions && viewItem == instruction",
          "group": "inline@2"
        }
      ],
      "file/newFile": [
        {
          "command": "opencrbasic.newProgram",
          "group": "file"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "openloggernet",
          "title": "Logger",
          "icon": "media/logger.svg"
        },
        {
          "id": "crbasic",
          "title": "CRBasic",
          "icon": "media/crbasic.svg"
        }
      ]
    },
    "views": {
      "openloggernet": [
        {
          "id": "openloggernet.station",
          "name": "Datalogger"
        },
        {
          "id": "openloggernet.files",
          "name": "Program and Files"
        },
        {
          "id": "openloggernet.public",
          "name": "Live Values (Public)"
        },
        {
          "id": "openloggernet.tables",
          "name": "Data Tables"
        },
        {
          "id": "openloggernet.settings",
          "name": "Device Settings",
          "visibility": "collapsed"
        }
      ],
      "crbasic": [
        {
          "id": "opencrbasic.instructions",
          "name": "Instructions"
        },
        {
          "id": "opencrbasic.instructionHelp",
          "name": "Instruction Help",
          "type": "webview"
        },
        {
          "id": "opencrbasic.dataTables",
          "name": "Data Tables"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "openloggernet.station",
        "contents": "Read the model, serial number, OS version, program and clock of the logger. Each scan opens the serial port only for as long as it takes.\n[$(search) Scan](command:openloggernet.scan.station)\n[Select Serial Port](command:openloggernet.selectLogger)"
      },
      {
        "view": "openloggernet.files",
        "contents": "The running program and the files on the logger.\n[$(search) Scan](command:openloggernet.scan.files)\n[Upload Files...](command:openloggernet.uploadFiles)"
      },
      {
        "view": "openloggernet.public",
        "contents": "Live values of the Public table, read every second. Connecting holds the serial port until you disconnect; other logger actions pause it while they run.\n[$(plug) Connect](command:openloggernet.connect)"
      },
      {
        "view": "openloggernet.tables",
        "contents": "The data tables of the running program.\n[$(search) Scan](command:openloggernet.scan.tables)\n[Download Data Tables...](command:openloggernet.downloadTables)"
      },
      {
        "view": "openloggernet.settings",
        "contents": "The logger's device settings, read and changed by name.\n[$(search) Scan](command:openloggernet.scan.settings)"
      },
      {
        "view": "opencrbasic.instructions",
        "contents": "Open a CRBasic program to list the instructions and functions of its logger.\n[New Program...](command:opencrbasic.newProgram)"
      },
      {
        "view": "opencrbasic.dataTables",
        "contents": "Open a CRBasic program to see the data tables it defines: each table's interval and fields, as the compiler builds them."
      }
    ],
    "keybindings": [
      {
        "command": "editor.action.addCommentLine",
        "key": "ctrl+'",
        "mac": "cmd+'",
        "when": "editorLangId == crbasic && editorTextFocus && !editorReadonly"
      },
      {
        "command": "editor.action.removeCommentLine",
        "key": "ctrl+shift+'",
        "mac": "cmd+shift+'",
        "when": "editorLangId == crbasic && editorTextFocus && !editorReadonly"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run bundle -- --minify",
    "compile": "tsc -p ./",
    "bundle": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --outfile=dist/extension.js",
    "watch": "npm run bundle -- --sourcemap --watch",
    "lint": "eslint src",
    "test": "npm run compile && node --test \"out/test/**/*.test.js\"",
    "package": "vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "10.1.2"
